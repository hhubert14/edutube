# YouTube Data API v3 key. Server-side only; never exposed to the client.
# Get one: Google Cloud Console > APIs & Services > Credentials > API key.
YOUTUBE_API_KEY=

# LLM key for the result quality assessment (OpenRouter by default, free models).
# Get one: https://openrouter.ai/keys
LLM_API_KEY=
# Optional: OpenAI-compatible base URL. Current default matches OpenRouter.
# LLM_BASE_URL=https://openrouter.ai/api/v1
# Optional: primary and fallback models. Defaults are both free: the
# free-model router (openrouter/free), then a specific free model if the router fails.
# LLM_MODEL=openrouter/free
# LLM_FALLBACK_MODEL=openai/gpt-oss-20b:free